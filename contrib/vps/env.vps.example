# Copy to the repo root as ".env" on the VPS and replace YOUR_DOMAIN.
# Passkeys are bound to this exact hostname: decide it once, before anyone registers.
RP_ID=YOUR_DOMAIN
ORIGIN=https://YOUR_DOMAIN
RP_NAME=Fitrix
FITRIX_PORT=8085

# The first profile created on a fresh server becomes the admin. Register yours right after the
# first start, then switch on the two lines under it (see RUNBOOK.md step 8).
FIRST_USER_ADMIN=1
#INVITE_ONLY=1
#ALLOW_GUEST=0

# Sign-in sessions last this many days.
SESSION_DAYS=90

# Contact for the push services.
VAPID_SUBJECT=mailto:faraaz.sheikh@gmail.com
